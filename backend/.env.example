PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/ai_seller_platform

# Encryption Key for Integration Credentials (32 bytes / SHA-256 secret)
INTEGRATION_ENCRYPTION_KEY=your_32_byte_secret_key_here

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI Provider Configuration (openai | gemini)
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payment & Billing Configuration (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Provider Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@sellerplatform.com
