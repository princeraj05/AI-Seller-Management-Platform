PORT=5000
NODE_ENV=production
MONGODB_URI=mongodb://localhost:27017/ai_seller_platform

# JWT Configuration (Access & Refresh Secrets must be distinct, min 32 chars in production)
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_chars_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_chars_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption Key for Integration Credentials (32 bytes / SHA-256 secret)
INTEGRATION_ENCRYPTION_KEY=your_32_byte_secret_key_here

# Firebase Admin SDK Configuration
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AI Provider Configuration (openai | gemini)
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=

# AI Microservice Integration (Python FastAPI)
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_SECRET=your_32_character_internal_service_secret_here
AI_SERVICE_TIMEOUT=60000

# Amazon SP-API Sandbox Configuration
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_APP_ID=
AMAZON_SP_API_ENV=sandbox
AMAZON_SP_API_REGION=eu
AMAZON_SP_API_REFRESH_TOKEN=

# Payment & Billing Configuration (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email Provider Configuration (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@sellerplatform.com
