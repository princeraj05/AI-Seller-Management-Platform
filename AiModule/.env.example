# Application Configuration
APP_NAME=BhartiyeCrafts-AI-Service
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Internal Shared Secret for Node.js <-> FastAPI Authentication
AI_SERVICE_SECRET=dev_internal_ai_service_secret_key_change_in_production_32b

# Main Node.js Backend Integration
NODE_BACKEND_URL=http://localhost:5000
NODE_BACKEND_TIMEOUT=15.0

# Phase 02 / 02.2: Computer Vision Model Provider Settings
# VISION_PROVIDER can be 'gemini' (cloud multimodal, recommended) or 'ollama' (local GPU)
VISION_PROVIDER=gemini
VISION_MODEL_NAME=gemini-3.8-flash
VISION_REQUEST_TIMEOUT=60.0

# Cloud Multimodal Vision Provider: Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=60.0

# Optional Local AI Provider: Ollama (Preserved for GPU environments)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl:7b

# Phase 02 / 02.1: OCR Engine Settings
OCR_ENABLED=true
OCR_LANGUAGE=en
OCR_WARMUP_ON_STARTUP=true

# Phase 02.3: Performance & Optimization Settings
GEMINI_PRIMARY_TIMEOUT=10.0
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_CIRCUIT_BREAKER_ENABLED=true
GEMINI_CIRCUIT_FAILURE_THRESHOLD=3
GEMINI_CIRCUIT_COOLDOWN_SECONDS=60.0
VISION_CACHE_ENABLED=true
VISION_CACHE_TTL_SECONDS=600
VISION_CACHE_MAX_ENTRIES=500

# Phase 02: Image Processing Limits
IMAGE_MAX_SIZE_MB=10
IMAGE_MAX_WIDTH=4096
IMAGE_MAX_HEIGHT=4096
IMAGE_MAX_DIMENSION=1536


