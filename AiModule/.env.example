# Application Configuration
APP_NAME=BhartiyeCrafts-AI-Service
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO

# Internal Shared Secret for Node.js <-> FastAPI Authentication
# In production, this must be a 32+ character high-entropy key matching backend AI_SERVICE_SECRET
AI_SERVICE_SECRET=dev_internal_ai_service_secret_key_change_in_production_32b

# Main Node.js Backend Integration
NODE_BACKEND_URL=http://localhost:5000
NODE_BACKEND_TIMEOUT=15.0

# Future AI Model Provider Configurations (Optional in Phase 01)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-vl:7b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
